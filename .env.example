# ── Agent model ───────────────────────────────────────────────────────────────
# The agent runs on any tool-calling chat model, closed or open weights. Pick a
# provider and a model id; set only the credential for the provider you chose.
# There is no default provider — an unset SIBYL_LLM_PROVIDER is an error rather
# than a silent request to somebody's paid endpoint.
#
# provider  = anthropic | openai | google | mistral | groq | ollama | openai_compatible
# model     = the vendor's own id, e.g. claude-opus-5, gpt-5, llama3.1:8b
SIBYL_LLM_PROVIDER=anthropic
SIBYL_LLM_MODEL=claude-opus-5

# Optional. Output cap, mapped to whatever the chosen vendor calls it.
# SIBYL_LLM_MAX_TOKENS=8192

# Required for openai_compatible, optional for ollama (defaults to localhost).
# Ignored by the hosted providers.
# SIBYL_LLM_BASE_URL=http://localhost:8000/v1

# ── Provider credentials — set only the one you selected above ────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=...
# ollama and openai_compatible need no credential.

# ── Not yet read by any code ──────────────────────────────────────────────────
# Weights & Biases
WANDB_API_KEY=...

# Stripe
STRIPE_SECRET_KEY=sk_test_...

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sibyl

# Storage
FAISS_INDEX_PATH=./data/faiss_index
