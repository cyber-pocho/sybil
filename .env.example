# ── Agent model ───────────────────────────────────────────────────────────────
# The agent runs on any tool-calling chat model, closed or open weights. Pick a
# provider and a model id; set only the credential for the provider you chose.
# There is no default provider — an unset SIBYL_LLM_PROVIDER is an error rather
# than a silent request to somebody's paid endpoint.
#
# provider  = anthropic | openai | google | mistral | groq | ollama | openai_compatible
# model     = the vendor's own id, e.g. claude-opus-5, gpt-5, llama3.1:8b
SIBYL_LLM_PROVIDER=anthropic
SIBYL_LLM_MODEL=claude-opus-5

# Optional. Output cap, mapped to whatever the chosen vendor calls it.
# SIBYL_LLM_MAX_TOKENS=8192

# Required for openai_compatible, optional for ollama (defaults to localhost).
# Ignored by the hosted providers.
# SIBYL_LLM_BASE_URL=http://localhost:8000/v1

# ── Provider credentials — set only the one you selected above ────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# MISTRAL_API_KEY=...
# GROQ_API_KEY=...
# ollama and openai_compatible need no credential.

# ── Persistence and task queue ────────────────────────────────────────────────
# SQLite by default, so a fresh clone runs with no infrastructure at all.
# docker-compose overrides both of these with its own services.
# DATABASE_URL=postgresql+psycopg://sibyl:sibyl@localhost:5432/sibyl
# REDIS_URL=redis://localhost:6379/0

# ── Vector search ─────────────────────────────────────────────────────────────
# Any sentence-transformers model id. Optional: unlike the chat provider above
# this one has a default, because getting it wrong downloads open weights rather
# than billing somebody. Changing it makes existing memories unsearchable until
# they are re-indexed — vectors from two models are not comparable, and the store
# keeps them apart rather than mixing them.
# SIBYL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# There is no index path. The memories table is the index; see
# src/sibyl/models/memory.py for why there is no file to point at.

# ── Not yet read by any code ──────────────────────────────────────────────────
# Weights & Biases
WANDB_API_KEY=...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
